# Configuración de variables de entorno para SITRE-RPC
# Este archivo se carga automáticamente con `python-dotenv`

# Ruta del proyecto
PROJECT_ROOT=.
PYTHONPATH=${PROJECT_ROOT}:${PROJECT_ROOT}/generated

# Configuración del servidor
SERVER_HOST=localhost
SERVER_PORT=50051

# Dispositivo para torch
TORCH_DEVICE=cpu

# Logging
LOG_LEVEL=INFO
