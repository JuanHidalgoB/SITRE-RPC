# Imagen CI para SITRE-RPC
# Contiene todas las dependencias (prod + dev) pre-instaladas.
# Reconstruir y subir solo cuando cambie pyproject.toml o uv.lock:
#   docker build -f Dockerfile.ci -t simonc2123/sitre-rpc-ci:latest .
#   docker push simonc2123/sitre-rpc-ci:latest

FROM python:3.10-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ci

COPY pyproject.toml uv.lock ./

# Instala todas las deps (prod + dev) en el sistema — sin proyecto, solo deps
RUN uv sync --frozen --no-install-project
